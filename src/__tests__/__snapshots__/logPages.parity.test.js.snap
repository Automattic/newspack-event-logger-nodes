// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`reads the Error Log as it read: default 1`] = `
{
  "body": "region "Error log"
  status
    "Connection lost. Reconnecting…"
  table "Error log"
    row "Time Request ID URL Keyword Message"
      columnheader "Time"
        "Time"
      columnheader "Request ID"
        "Request ID"
      columnheader "URL"
        "URL"
      columnheader "Keyword"
        "Keyword"
      columnheader "Message"
        "Message"
    rowgroup
      row "<time>.000 weka-7913 stderr Worker restarted 7913"
        cell "<time>.000"
          "<time>.000"
        cell "weka-7913"
          link "weka-7913"
            "weka-7913"
        cell
        cell "stderr"
          "stderr"
        cell "Worker restarted 7913"
          "Worker restarted 7913"
      row "<time>.000 kaka-7912 POST https://www.kea-7900.example/forest/7912 warning Slow query 7912"
        cell "<time>.000"
          "<time>.000"
        cell "kaka-7912"
          link "kaka-7912"
            "kaka-7912"
        cell "POST https://www.kea-7900.example/forest/7912"
          "POST"
          link "https://www.kea-7900.example/forest/7912"
            "https://www.kea-7900.example/forest/7912"
        cell "warning"
          "warning"
        cell "Slow query 7912"
          "Slow query 7912"
      row "<time>.000 kea-7911 GET https://www.kea-7900.example/alpine/7911 php (error) Undefined index: ridge7911"
        cell "<time>.000"
          "<time>.000"
        cell "kea-7911"
          link "kea-7911"
            "kea-7911"
        cell "GET https://www.kea-7900.example/alpine/7911"
          "GET"
          link "https://www.kea-7900.example/alpine/7911"
            "https://www.kea-7900.example/alpine/7911"
        cell "php (error)"
          "php (error)"
        cell "Undefined index: ridge7911"
          "Undefined index: ridge7911"",
  "header": ""3 entries"
"<rate>"
combobox "Browse a partition"
  option "All partitions (live)"
    "All partitions (live)"
  option "errors.p1"
    "errors.p1"
  option "errors.p4"
    "errors.p4"
"Filter the stream"
searchbox "Filter the stream"
button "Pause streaming"
  "⏸"
button "Debug"
  "Debug"
button "Clear"
  "Clear"",
}
`;

