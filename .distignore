# Files to exclude from the installable plugin zip.
# Used by `./build-release.sh` via `rsync --exclude-from=.distignore`.
#
# NOTE: composer.json / composer.lock are NOT excluded — build-release.sh
# runs `composer install --no-dev --optimize-autoloader` inside staging after
# the rsync, so those files must ride along. They're removed from staging
# right before the zip step.

# OS noise (appears spontaneously during dev/build)
.DS_Store
._*
*.log
Thumbs.db

# Build output and staging (avoid self-recursion in rsync)
.release-staging
/release

# VCS / IDE
.claude
.git
.gitignore
.vscode

# Dev tooling / configs
.distignore
build-release.sh
cghooks.lock
commitlint.config.js
package-lock.json
package.json
phpcs.xml.dist
phpstan.neon.dist

# Dev infrastructure — not part of the installable plugin
/coverage
/scripts
/src
/tests
/vendor
node_modules

# Dev documentation (WordPress.org reads readme.txt; README.md is GitHub-only)
AGENTS.md
API.md
ARCHITECTURE.md
CHANGELOG.md
CLAUDE.md
MIGRATION.md
README.md

# Ships as a standalone release asset (must-use plugin under wp-content/mu-plugins/)
# rather than as a regular plugin under wp-content/plugins/. Bundling it inside
# the plugin zip makes WordPress show a phantom "00-newspack-profiler" plugin
# in the admin and risks double-loading if anyone activates it.
00-newspack-profiler.php
