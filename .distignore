# Ships as a standalone release asset (must-use plugin under wp-content/mu-plugins/)
# rather than as a regular plugin under wp-content/plugins/. Bundling it inside
# the plugin zip makes WordPress show a phantom "00-newspack-profiler" plugin
# in the admin and risks double-loading if anyone activates it.
00-newspack-profiler.php

# Source files (built assets only)
src/**/*.js
src/**/*.scss
