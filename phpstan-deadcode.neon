# PHPStan gate with dead-code detection enabled.
#
# shipmonk/dead-code-detector is excluded from the auto-loaded extension set
# (see composer.json extra.phpstan/extension-installer.ignore), so use this
# explicit config whenever running the project PHPStan gate:
#
#     npm run lint:phpstan
#
# Caveat: this is an APPLICATION on top of the newspack-nodes substrate. tests/
# are excluded (inherited from the main config) so test-only methods surface,
# and the detector can't see the substrate's dynamic dispatch, WP hooks, WP-CLI
# entrypoints, REST routes, or JS↔PHP wire constants — so most findings are
# live-by-reflection/hook, NOT genuinely dead. Verify each finding against ALL
# call paths (hooks, reflection, the .tsl topologies, and JS) before deleting.
includes:
    - phpstan.neon.dist
    - vendor/shipmonk/dead-code-detector/rules.neon
parameters:
    # Keep ShipMonk's collected-data cache project-local. The default global
    # PHPStan tmp dir can race when multiple plugin gates run concurrently.
    tmpDir: .phpstan/cache/deadcode
    # Real-load the substrate's Newspack_Nodes\* base classes during analysis —
    # the dead-code-detector's reflection providers invoke the actual autoloader
    # (scanDirectories alone isn't enough). Merged with phpstan.neon.dist's
    # bootstrapFiles. See the bootstrap for the full rationale.
    bootstrapFiles:
        - .phpstan/load-substrate.php
