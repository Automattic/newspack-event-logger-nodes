# Complete topology: one worker runs request-builder, flame-builder,
# job-router, and job-worker together.

# Restated: an included var is ignored, and job-hub's worker needs 600s.
var stale_timeout = 600

include performance
include job-hub
make_node Tee firehose:tee
disconnect_node firehose:consumer
connect_node firehose:consumer firehose:tee
connect_node firehose:tee request-builder
connect_node firehose:tee job-router
secure
