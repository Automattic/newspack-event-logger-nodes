# Flame_Builder topology.
#
#   Consumer (requests.log) ─→ FlameBuilder ─→ Partition (flames:partition)
#                                            └→ Row_Table (flame-facts, Flame_Facts, by message via set_facts_target)
#                                            └→ flame-builder:auto-tuner (owned sibling, hidden)
#   Overview_Prefetch_Tick (Router tick) ─→ firehose job entry + jobfeed.p0, every two minutes
#   table-probe sweeps the Row_Table into the station's Tables tab

var on_demand_idle = 30

include topic-probe
include table-probe

make_node Consumer requests:consumer <config:logs_dir>/requests.p{partition} <config:offsets_dir>/<topology>.requests.p{partition} <config:deadletter_dir>/<topology>.requests.p{partition}
make_node Flame_Builder flame-builder
make_node Partition flames:partition <config:logs_dir>/flames.p{partition}
make_node Row_Table flame-facts Flame_Facts
make_node Overview_Prefetch_Tick overview-prefetch:tick
command_node requests:consumer:config add_snapshot_node flame-builder
command_node flame-builder:config set_facts_target flame-facts
command_node flames:partition:config void_warranty
command_node flames:partition:config with_index flame-index
connect_node requests:consumer flame-builder
connect_node flame-builder flames:partition
secure
