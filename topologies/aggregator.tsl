# Aggregator topology (hub side).
#
#   StreamMerger ─→ Topic (firehose:topic)   (multi-partition, KEY-routed)
#
# StreamMerger owns a HealthCheckTick sibling (patron-linked, named
# `stream-merger:health-check`) that hitchhikes the same Router TIMER
# heartbeat and enqueues the periodic discovery + sync sweep. Both
# timers register automatically on first name() — no explicit
# `start_periodic_tick` verb is needed.
#
# The k:"job" -> k:"remote_job" rewrite filter is registered statically
# at plugin load (StreamMerger::register_remote_job_rewrite_filter), not
# from TSL.

make_node Topic firehose:topic <config:logs_dir>/firehose.log <config:num_partitions> <config:segment_size> <config:num_segments> <config:max_lifespan>

make_node StreamMerger stream-merger firehose <partition>
connect_node stream-merger firehose:topic
cmd stream-merger:config set_verify_ssl <config:aggregator_verify_ssl>
cmd stream-merger:config set_require_https <config:aggregator_require_https>
cmd stream-merger:config load_remotes_from_registry
