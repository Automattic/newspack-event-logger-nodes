# Aggregator topology (hub side).
#
#   StreamMerger ─→ Topic (firehose:topic)   (multi-partition, KEY-routed)
#   HealthCheckTick (Router-TIMER hitchhike, owned by aggregator)
#
# Always single-partition (the StreamMerger is itself a fan-in; partition
# count comes from the destination Topic). The k:"job" -> k:"remote_job"
# rewrite filter is registered statically at plugin load
# (StreamMerger::register_remote_job_rewrite_filter), not from TSL.

# Frontmatter — supervisor reads these via Topology_Registry::frontmatter().
var num_partitions = 1;

make_node Topic firehose:topic <config:logs_dir>/firehose.log <config:num_partitions> <config:segment_size> <config:num_segments> <config:max_lifespan>

make_node StreamMerger stream-merger
connect_node stream-merger firehose:topic
cmd stream-merger:config set_verify_ssl <config:aggregator_verify_ssl>
cmd stream-merger:config set_require_https <config:aggregator_require_https>
cmd stream-merger:config load_remotes_from_registry
cmd stream-merger:config start_periodic_tick

make_node HealthCheckTick health-check-tick
cmd health-check-tick:config start_periodic_tick
