#: src/rules/RuleEditModal.js:534
msgid "Log database queries"
msgstr ""

#: src/rules/RuleEditModal.js:538
msgid "Times every query as its own flame span. Each query adds two entries to the request's log, so a request running hundreds of them leaves a large record, which may be folded under memory pressure."
msgstr ""

#: src/rules/RuleEditModal.js:548
msgid "Log HTTP requests"
msgstr ""

#: src/rules/RuleEditModal.js:552
msgid "Times every outbound HTTP request as its own flame span. Each outbound call adds two entries to the request's log."
msgstr ""

#: src/rules/RuleEditModal.js:562
msgid "Log plugin load time"
msgstr ""

#: src/rules/RuleEditModal.js:566
msgid "Times each site-activated plugin as its own flame span. The measuring happens either way; this is two log entries per plugin, before the request does any work."
msgstr ""

#: src/rules/RuleEditModal.js:576
msgid "Log peak memory on every span"
msgstr ""

#: src/rules/RuleEditModal.js:580
msgid "Adds the process's peak memory to every span's close, so memory growth reads across the request's timeline. The request's own close carries it either way."
msgstr ""

#: src/rules/RuleEditModal.js:590
msgid "Log request context"
msgstr ""

#: src/rules/RuleEditModal.js:594
msgid "Adds one entry to the request's log naming the template WordPress included, the rewrite rule and query it matched, its query vars and the conditionals the main query answers true."
msgstr ""

#: src/rules/RuleEditModal.js:604
msgid "Log object cache counts"
msgstr ""

#: src/rules/RuleEditModal.js:608
msgid "Adds one entry to the request's log counting its object-cache hits and misses."
msgstr ""

#: src/rules/RuleEditModal.js:618
msgid "Log resource usage"
msgstr ""

#: src/rules/RuleEditModal.js:622
msgid "Adds two entries to the request's log, its CPU time, page faults, I/O blocks and context switches at the start and at the end. The CPU figures beside a finding's gaps come from these."
msgstr ""

#: src/rules/RuleEditModal.js:632
msgid "Log PHP errors"
msgstr ""

#: src/rules/RuleEditModal.js:636
msgid "Adds one entry to the request's log for each distinct PHP warning, notice or deprecation, and for each of WordPress's own deprecation and misuse notices, naming the file, the line and the plugin or theme that owns it. A repeat is counted, not logged, in one entry at the request's end. Errors PHP or WordPress would have hidden are logged too, and marked silenced."
msgstr ""

#: src/rules/RuleEditModal.js:646
msgid "Flush every line"
msgstr ""

#: src/rules/RuleEditModal.js:650
msgid "Writes each entry to disk as it is logged, so the last line before a crash or an out-of-memory kill survives. Costs one write per entry."
msgstr ""

#: src/rules/RuleEditModal.js:661
msgid "Trace hook callers"
msgstr ""

#: src/rules/RuleEditModal.js:667
msgid "Labels every hook span with who called it, so a hook that runs many times splits by caller in the flame graph. The number traces that many calls from each CALLER of a hook, query shape or outbound URL further, recording the twenty frames above each — expensive, so 1 already reaches every caller. At 0 every span still carries its label and none records a backtrace."
msgstr ""

#: src/rules/RuleEditModal.js:671
msgid "Labels every hook span with who called it, so a hook that runs many times splits by caller in the flame graph."
