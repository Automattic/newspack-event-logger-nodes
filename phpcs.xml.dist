<?xml version="1.0"?>
<ruleset name="Newspack Event Logger Nodes">
	<description>PHP Coding Standards for the Newspack Event Logger Nodes plugin.</description>

	<!-- Scan plugin source -->
	<file>./includes</file>
	<file>./mu-plugins</file>
	<file>./newspack-event-logger-nodes.php</file>
	<file>./newspack-event-logger-nodes-config.php</file>

	<!-- Exclude build, vendor, and dependency directories -->
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/scripts/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/.phpstan/cache/*</exclude-pattern>

	<!-- How to scan -->
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- Rules: WordPress VIP Go Coding Standards -->
	<rule ref="WordPress-VIP-Go">
		<!-- Exclude JS sniffs that cause PHPCS 4.0 deprecation warnings -->
		<exclude name="WordPressVIPMinimum.JS"/>
	</rule>

	<!-- Unused locals. PHPStan cannot see these at ANY level: it reasons about
	     types and reachability, not the liveness of locals. VIP-Go silences this
	     sniff (severity 0, "these don't affect us on VIP Go") — we want it, so it
	     is re-raised here as an error. Must come AFTER the VIP-Go ref. -->
	<rule ref="VariableAnalysis.CodeAnalysis.VariableAnalysis">
		<properties>
			<property name="allowUnusedCaughtExceptions" value="true"/>
			<!-- Parameters are fixed by contract (hook callbacks, interface
			     implementations that ignore an argument). Locals are the ones
			     that indicate dead code. -->
			<property name="allowUnusedFunctionParameters" value="true"/>
		</properties>
	</rule>
	<rule ref="VariableAnalysis.CodeAnalysis.VariableAnalysis.UnusedVariable">
		<severity>5</severity>
		<type>error</type>
	</rule>

	<!-- The config ledger IS commented-out code: every key ships commented out
	     beside its default, and scripts/lint-comments.php gates the shape
	     instead (each comment run must name a key). -->
	<rule ref="Squiz.PHP.CommentedOutCode">
		<exclude-pattern>*/newspack-event-logger-nodes-config.php</exclude-pattern>
	</rule>

	<!-- Text domain for translations -->
	<config name="text_domain" value="newspack-event-logger-nodes"/>

	<!-- Allow short array syntax -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

	<!-- WordPress version check -->
	<config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
